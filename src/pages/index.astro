---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Deco from '../components/Deco.astro';
import Cierre from '../components/Cierre.astro';
import Retrato from '../components/Retrato.astro';
import { retrato } from '../data/retratos';
import ObrasSociales from '../components/ObrasSociales.astro';
import { foto } from '../data/fotos';
import {
  centro,
  contacto,
  servicios,
  profesionales,
  obrasSociales,
  aranceles,
  galeria,
  bandaHero,
  metricas,
} from '../data/contenido';

const evaluaciones = servicios.find((s) => s.slug === 'evaluaciones-deportivas');
---

<Base
  titulo="PhysioMove | Kinesiología deportiva en Río Gallegos"
  descripcion="Centro deportivo especializado en Río Gallegos: kinesiología deportiva y traumatológica, readaptación, evaluaciones con tecnología IVOLUTION, nutrición deportiva y recovery. Donde volvés al deporte."
  ruta="/"
>
  <!-- ============================================================ HERO -->
  <section class="hero oscuro">
    <Deco variante="hero-oscuro" />

    <div class="hero__cabeza">
      <div class="contenedor">
        <div class="hero__meta" data-hero-anima>
          <span class="hero__meta-lugar">{contacto.localidad}</span>
          <p class="hero__meta-frase">Donde volvés al deporte</p>
          <span class="hero__meta-lugar hero__meta-lugar--der">{contacto.provincia}</span>
        </div>
        <h1 class="titulo-xxl hero__titulo" data-hero-titulo>
          Centro Deportivo<br /><span class="hero__frase-fuerte">Especializado</span>
        </h1>
        <div class="hero__acciones" data-hero-anima>
          <a class="btn btn--claro" href={contacto.whatsappTexto} target="_blank" rel="noopener">
            Agendá tu turno
          </a>
          <a class="btn btn--linea" href="/servicios">Ver servicios</a>
        </div>

        <p class="hero__obras" data-hero-anima>
          Trabajamos con <a href="/obras-sociales">obras sociales y prepagas</a>
        </p>

        <dl class="hero__stats" data-hero-anima>
          {
            metricas.map((m) => (
              <div class="stat">
                <dd class="stat__numero" data-conteo={m.valor}>
                  {m.valor}
                </dd>
                <dt class="stat__texto">{m.texto}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!--
      Banda de fotos verticales a sangre. La tira es mas ancha que el viewport a
      proposito: las de los extremos se cortan contra el borde. El material del
      cliente es 16 de 18 fotos en 3:4, asi que la banda usa la foto como viene,
      sin recortes ni relleno inventado.
    -->
    <div class="hero__banda" data-hero-banda>
      <ul class="hero__tira" role="list">
        {
          bandaHero.map((item, i) => (
            <li
              class="hero__carta"
              data-hero-carta
              style={`--giro:${item.giro}deg;--baja:${item.baja};--vel:${item.vel}`}
            >
              <div class="hero__marco" data-hero-marco>
                <Picture
                  src={foto(item.foto)}
                  formats={['avif', 'webp']}
                  widths={[320, 500, 700]}
                  sizes="(max-width: 900px) 46vw, 24vw"
                  alt={item.alt}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  fetchpriority={i === 3 ? 'high' : undefined}
                  data-hero-img={i === 3 ? '' : undefined}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ====================================================== 01 ORIGEN -->
  <section class="seccion crema">
    <Deco variante="suave" />
    <div class="contenedor">
      <div class="origen__grid">
        <figure class="origen__figura foto-formas rv">
          <Picture
            src={foto('como-inicio')}
            formats={['avif', 'webp']}
            widths={[480, 760, 1000]}
            sizes="(max-width: 900px) 100vw, 36vw"
            alt="Marcos y Sofía, mate en mano, entre el público de una jornada de formación en kinesiología"
            loading="lazy"
            pictureAttributes={{ class: 'origen__marco marco-foto' }}
            data-parallax
          />
        </figure>

        <div>
          <p class="volanta">Cómo nació PhysioMove</p>
          <p class="origen__cita" data-lineas>
            La recuperación de una lesión debía ser <em>en movimiento</em>.
          </p>
          <div class="parrafos">
            {centro.origen.map((p) => <p class="bajada rv">{p}</p>)}
          </div>
          <div class="origen__dato rv">
            <strong>{centro.apertura}</strong>
            <span class="bajada" style="font-size:.95rem"
              >Año en que abrimos nuestras puertas en {contacto.localidad}, {contacto.provincia}.</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================ 02 DIFERENCIAL -->
  <section class="seccion dif oscuro">
    <Deco variante="oscura" />
    <div class="contenedor">
      <div class="dif__grid">
        <div>
          <p class="volanta">¿Qué nos diferencia?</p>
          <h2 class="dif__titulo" data-lineas>
            Una mirada integral, <em>basada en evidencia</em>.
          </h2>
          <div class="parrafos">
            {centro.diferencial.map((p) => <p class="dif__texto rv">{p}</p>)}
          </div>

          <div class="dif__claves">
            <div class="dif__clave rv">
              <span>01</span>
              <div class="parrafos">
                <p><b>A quiénes acompañamos.</b> {centro.pacientes[0]}</p>
                {centro.pacientes.slice(1).map((p) => <p>{p}</p>)}
              </div>
            </div>
            <div class="dif__clave rv">
              <span>02</span>
              <div class="parrafos">
                <p><b>Nuestra forma de trabajar.</b> {centro.postura[0]}</p>
                {centro.postura.slice(1).map((p) => <p>{p}</p>)}
              </div>
            </div>
          </div>
        </div>

        <div class="dif__figuras foto-formas foto-formas--simple rv">
          <Picture
            src={foto('razonamiento-datos')}
            formats={['avif', 'webp']}
            widths={[420, 700]}
            sizes="(max-width: 900px) 100vw, 30vw"
            alt="Pantalla con los datos de un test de fuerza durante una evaluación en PhysioMove"
            loading="lazy"
            pictureAttributes={{ class: 'dif__foto--grande marco-foto' }}
            data-parallax
          />
          <Picture
            src={foto('razonamiento-cientifico')}
            formats={['avif', 'webp']}
            widths={[320, 520]}
            sizes="(max-width: 900px) 50vw, 18vw"
            alt="Deportista de pie sobre la plataforma de salto con la curva del test en la laptop"
            loading="lazy"
            pictureAttributes={{ class: 'dif__foto--chica marco-foto' }}
            data-parallax
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =================================================== 03 SERVICIOS -->
  <section class="seccion" data-svc>
    <div class="contenedor">
      <div class="svc__grid">
        <div class="svc__panel" data-svc-panel>
          <p class="volanta">Servicios</p>
          <h2 class="titulo-l" data-lineas>Qué hacemos<br />en PhysioMove</h2>
          <ol class="svc__indice" data-svc-indice>
            {
              servicios.map((s, i) => (
                <li data-activo={i === 0 ? 'true' : 'false'}>
                  <span>{s.numero}</span>
                  {s.corto}
                </li>
              ))
            }
          </ol>
          <div class="svc__progreso"><i data-svc-progreso></i></div>
          <p class="bajada rv" style="margin-top:2rem;font-size:.95rem">
            Cada servicio tiene su página con el detalle completo. Entrá en el que te corresponda
            o escribinos y lo vemos juntos.
          </p>
        </div>

        <div class="svc__lista" data-svc-lista>
          {
            servicios.map((s) => (
              <a class="svc__card rv" href={`/servicios/${s.slug}`} data-svc-card>
                <figure>
                  <Picture
                    src={foto(s.foto)}
                    formats={['avif', 'webp']}
                    widths={[380, 620]}
                    sizes="(max-width: 640px) 100vw, 26vw"
                    alt={s.fotoAlt}
                    loading="lazy"
                    style={s.fotoPosicion ? `object-position:${s.fotoPosicion}` : undefined}
                  />
                </figure>
                <div class="svc__card__cuerpo">
                  <p class="numeral">{s.numero}</p>
                  <h3>{s.nombre}</h3>
                  <p>{s.resumen}</p>
                  <span class="svc__card__mas">
                    Ver el servicio
                    <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                      <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    04, 05 y 06 son secciones nuevas (PDF del 12/9/2026). El documento sigue la
    home de arriba abajo y estas tres van entre los servicios y "El centro".
  -->
  <!-- ========================================= 04 FORMA DE TRABAJAR -->
  <section class="seccion oscuro metodo">
    <Deco variante="oscura" />
    <div class="contenedor">
      <div class="metodo__grid">
        <div>
          <p class="volanta">Nuestra forma de trabajar</p>
          <h2 class="titulo-l" data-lineas>
            Distintas áreas.<br />Una misma forma<br />de trabajar.
          </h2>
        </div>
        <div class="parrafos">
          {centro.formaDeTrabajar.map((p) => <p class="bajada rv">{p}</p>)}
        </div>
      </div>

      <ol class="metodo__pasos" role="list" aria-label={centro.lema}>
        {
          centro.pasos.map((paso, i) => (
            <li class="rv">
              <span class="numeral">0{i + 1}</span>
              {paso}.
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================ 05 EVALUACIONES -->
  <section class="seccion crema medir">
    <Deco variante="suave" />
    <div class="contenedor">
      <div class="medir__grid">
        <div>
          <p class="volanta">Evaluaciones deportivas</p>
          <h2 class="titulo-l" data-lineas>Medir para tomar<br />mejores decisiones.</h2>
          <div class="parrafos" style="margin-top:1.75rem">
            {centro.evaluaciones.map((p) => <p class="bajada rv">{p}</p>)}
          </div>
        </div>

        <div>
          <ol class="medir__lista" role="list">
            {
              centro.evaluacionesTipos.map((tipo, i) => (
                <li class="rv">
                  <span>0{i + 1}</span>
                  {tipo}
                </li>
              ))
            }
          </ol>
          {
            evaluaciones && (
              <p class="rv medir__enlace">
                <a class="enlace" href={`/servicios/${evaluaciones.slug}`}>
                  Ver el servicio
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                    <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== 06 TECNOLOGIA -->
  <section class="seccion tecnologia">
    <div class="contenedor">
      <div class="cabecera__grid">
        <div>
          <p class="volanta">Tecnología IVOLUTION</p>
          <h2 class="titulo-l" data-lineas>Tecnología aplicada<br />a la evaluación.</h2>
          <div class="parrafos" style="margin-top:1.75rem">
            {centro.tecnologia.map((p) => <p class="bajada rv">{p}</p>)}
          </div>
        </div>

        <!--
          El PDF pide una foto real de la sede con IVOLUTION. Esta es el test
          con dinamometro: la cinta en la pierna y la app con la curva en la
          laptop. Es 3:4 y el marco 5:4: se encuadra abajo, donde esta la pantalla.
        -->
        <figure class="cabecera__figura rv">
          <Picture
            pictureAttributes={{ class: 'cabecera__marco marco-foto' }}
            data-parallax
            src={foto('evaluacion-dinamometro')}
            formats={['avif', 'webp']}
            widths={[520, 800, 1100]}
            sizes="(max-width: 760px) 100vw, 42vw"
            alt="Test de fuerza con dinamómetro IVOLUTION en PhysioMove: el deportista en la colchoneta con la cinta en la pierna y la curva del test en la laptop"
            loading="lazy"
            style="object-position:50% 72%"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ==================================================== 07 EL CENTRO -->
  <section class="galeria oscuro" data-galeria>
    <div class="contenedor galeria__cabecera">
      <div>
        <p class="volanta">El centro</p>
        <h2 class="titulo-l" data-lineas>Un espacio pensado<br />para moverse</h2>
      </div>
      <div class="parrafos" style="max-width:38ch">
        {centro.espacio.map((p) => <p class="bajada">{p}</p>)}
      </div>
    </div>

    <div class="galeria__pista" data-galeria-pista>
      {
        galeria.map((g, i) => (
          <figure class="galeria__item">
            <Picture
              src={foto(g.foto)}
              formats={['avif', 'webp']}
              widths={[320, 520, 840]}
              sizes="(max-width: 1000px) 74vw, 30vw"
              alt={g.alt}
              loading="lazy"
            />
            <figcaption>{String(i + 1).padStart(2, '0')} — {g.titulo}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ====================================================== 08 EQUIPO -->
  <section class="seccion crema">
    <Deco variante="suave" />
    <div class="contenedor">
      <div
        style="display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap"
      >
        <div>
          <p class="volanta">Quiénes te atienden</p>
          <h2 class="titulo-l" data-lineas>
            Un equipo.<br />Diferentes miradas.<br />Un mismo objetivo.
          </h2>
        </div>
        <a class="enlace" href="/equipo">
          Ver las fichas completas
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>

      <div class="equipo__intro">
        <div class="parrafos">
          {centro.equipo.map((p) => <p class="bajada rv">{p}</p>)}
        </div>
        <p class="numeral rv equipo__areas">Áreas: {centro.areas.join(' · ')}</p>
      </div>

      <div class="equipo__grid" style={`--cols:${profesionales.length}`}>
        {
          profesionales.map((p) => (
            <article class="persona rv">
              <Retrato iniciales={p.iniciales} nombre={p.nombre} foto={retrato(p.retrato)} />
              <div class="persona__cuerpo">
                <h3>{p.nombre}</h3>
                <p class="persona__titulo">{p.titulo}</p>
                {p.matricula && <p class="persona__mp">{p.matricula}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================== 09 OBRAS SOCIALES -->
  <section class="seccion">
    <div class="contenedor">
      <div
        style="display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap"
      >
        <div>
          <p class="volanta">Obras sociales y prepagas</p>
          <h2 class="titulo-l" data-lineas>Trabajamos con<br />{obrasSociales.length} coberturas</h2>
        </div>
        <a class="enlace" href="/obras-sociales">
          Aranceles y requisitos
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>

      <ObrasSociales />
      <p class="os__nota rv"><sup>*</sup><span>{aranceles.notaCopago}</span></p>
    </div>
  </section>

  <!-- ============================================================ SEDE -->
  <section class="seccion oscuro sede">
    <Deco variante="sede" />
    <div>
      <div class="sede__grid">
        <div class="sede__texto">
          <p class="volanta">La sede</p>
          <h2 class="titulo-l" data-lineas>{contacto.direccion}<br />{contacto.localidad}</h2>
          <dl class="sede__datos">
            <div class="sede__dato rv">
              <dt>Dirección</dt>
              <dd>
                {contacto.direccion}, {contacto.localidad}, {contacto.provincia}.<br />
                {contacto.entre}.
              </dd>
            </div>
            <div class="sede__dato rv">
              <dt>Horarios</dt>
              <dd>
                {contacto.horarios.map((h) => <span>{h.dias}: {h.horas}<br /></span>)}
              </dd>
            </div>
            <div class="sede__dato rv">
              <dt>Turnos</dt>
              <dd>
                <a href={contacto.whatsappTexto} target="_blank" rel="noopener"
                  >WhatsApp {contacto.telefono}</a
                ><br />
                <a href={contacto.turnosOnline} target="_blank" rel="noopener"
                  >Autogestión de turnos online</a
                ><br />
                <a href={`mailto:${contacto.mail}`}>{contacto.mail}</a>
              </dd>
            </div>
          </dl>
          <div class="rv" style="margin-top:2.25rem">
            <a class="btn btn--claro" href="/contacto">Cómo llegar</a>
          </div>
        </div>

        <div class="sede__figura">
          <iframe
            class="sede__mapa"
            src={contacto.mapaEmbed}
            title={`Mapa con la ubicación de ${centro.nombre} en ${contacto.direccion}, ${contacto.localidad}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>

  <Cierre titulo={centro.lema} texto={centro.cierre} />
</Base>
