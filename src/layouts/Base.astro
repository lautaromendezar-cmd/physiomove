---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import PieDePagina from '../components/PieDePagina.astro';
import Preloader from '../components/Preloader.astro';
import { centro, contacto, servicios } from '../data/contenido';

interface Props {
  titulo: string;
  descripcion: string;
  /** Se usa para el canonical y el og:url */
  ruta?: string;
}

const { titulo, descripcion, ruta = Astro.url.pathname } = Astro.props;
const canonical = new URL(ruta, Astro.site).href;
const og = new URL('/og-physiomove.jpg', Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'Physiotherapy'],
  '@id': new URL('/', Astro.site).href,
  name: `${centro.nombre} — ${centro.bajada}`,
  alternateName: 'PhysioMove Río Gallegos',
  slogan: centro.frase,
  description: centro.diferencial.join(' '),
  url: new URL('/', Astro.site).href,
  image: og,
  logo: new URL('/favicon-512.png', Astro.site).href,
  telephone: contacto.telefonoE164,
  email: contacto.mail,
  foundingDate: String(centro.apertura),
  priceRange: '$$',
  currenciesAccepted: 'ARS',
  medicalSpecialty: 'PhysicalTherapy',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacto.direccion,
    addressLocality: contacto.localidad,
    addressRegion: contacto.provincia,
    postalCode: contacto.codigoPostal,
    addressCountry: 'AR',
  },
  areaServed: { '@type': 'City', name: contacto.localidad },
  sameAs: [contacto.instagram],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '20:00',
    },
  ],
  availableService: servicios.map((s) => ({
    '@type': 'MedicalTherapy',
    name: s.nombre,
    description: s.resumen,
    url: new URL(`/servicios/${s.slug}`, Astro.site).href,
  })),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#002B4A" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={centro.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Oswald:wght@400;500;600;700&display=swap"
    />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />

    <script is:inline>
      // Clase `js` -> habilita los estados iniciales de las animaciones.
      // Si este script no corre, el CSS nunca oculta nada y la pagina se ve entera.
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add('js');
        var reducido =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var visto = false;
        try {
          visto = sessionStorage.getItem('pm-visto') === '1';
        } catch (e) {}

        if (visto || reducido) {
          raiz.classList.add('pm-visto');
        } else {
          raiz.classList.add('pm-cargando');
          // Red de seguridad: pase lo que pase con el JS de animaciones,
          // a los 4,5 s el overlay se va y la pagina queda usable.
          setTimeout(function () {
            raiz.classList.remove('pm-cargando');
            raiz.classList.add('pm-visto');
            var pre = document.querySelector('[data-pre]');
            if (pre && pre.parentNode) pre.parentNode.removeChild(pre);
          }, 4500);
        }
        try {
          sessionStorage.setItem('pm-visto', '1');
        } catch (e) {}

        // Salto al #hash a mano. El root tiene scroll-behavior:smooth y con eso
        // Chrome no completa el salto de la carga inicial: arranca el scroll
        // animado y el trabajo de la pagina lo cancela (medido: sin JS salta,
        // con JS se queda arriba). Va instantaneo y se repite cuando cargan las
        // fuentes, que corren el destino unos px. Si el usuario ya scrolleo por
        // su cuenta no se le toca nada.
        if (location.hash.length > 1) {
          var ultimo = -1;
          var saltar = function () {
            // Si el usuario ya movio la pagina por su cuenta, no se le toca.
            if (ultimo >= 0 && Math.abs(window.scrollY - ultimo) > 4) return;
            var destino;
            try {
              destino = document.getElementById(decodeURIComponent(location.hash.slice(1)));
            } catch (e) {}
            if (!destino) return;
            // El margen sale del CSS (scroll-margin-top), que ya tiene en cuenta
            // el header sticky: no se repite el numero aca.
            var margen = parseFloat(getComputedStyle(destino).scrollMarginTop) || 0;
            var y = destino.getBoundingClientRect().top + window.scrollY - margen;
            // El root tiene scroll-behavior:smooth y eso alcanza a todo scroll
            // programatico, scrollIntoView incluido. Se apaga el tiempo justo:
            // con la animacion andando, el reintento de las fuentes la cancelaba
            // a mitad de camino y la primera ficha se quedaba sin saltar.
            var estilo = document.documentElement.style;
            var previo = estilo.scrollBehavior;
            estilo.scrollBehavior = 'auto';
            window.scrollTo(0, Math.max(0, y));
            estilo.scrollBehavior = previo;
            ultimo = window.scrollY;
          };
          window.addEventListener('load', function () {
            saltar();
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(saltar);
            setTimeout(saltar, 400);
          });
        }
      })();
    </script>
  </head>

  <body>
    <a class="salto" href="#contenido">Ir al contenido</a>
    <Preloader />
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <PieDePagina />

    <a
      class="wa"
      href={contacto.whatsappTexto}
      target="_blank"
      rel="noopener"
      aria-label="Escribinos por WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
      </svg>
    </a>

    <script>
      import '../scripts/animaciones';
    </script>
  </body>
</html>
