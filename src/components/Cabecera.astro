---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo.png';
import { centro, contacto } from '../data/contenido';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const actual = (href: string) =>
  href === '/' ? ruta === '/' : ruta.startsWith(href.replace(/\/$/, ''));

const enlaces = [
  { href: '/servicios', texto: 'Servicios' },
  { href: '/equipo', texto: 'Equipo' },
  { href: '/obras-sociales', texto: 'Obras sociales' },
  { href: '/contacto', texto: 'Contacto' },
];
---

<header class="pm-header" data-header>
  <div class="contenedor pm-header__inner">
    <a class="pm-logo" href="/" aria-label={`${centro.nombre}, inicio`}>
      <Image src={logo} alt="" width={88} height={88} loading="eager" />
      <span class="pm-logo__texto">
        {centro.nombre}
        <small>Centro deportivo especializado</small>
      </span>
    </a>

    <nav class="pm-nav" id="menu" data-menu aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} aria-current={actual(e.href) ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
      <a class="btn" href={contacto.whatsappTexto} target="_blank" rel="noopener">
        Agendá tu turno
      </a>
    </nav>

    <a
      class="btn pm-header__cta"
      href={contacto.whatsappTexto}
      target="_blank"
      rel="noopener">Agendá tu turno</a
    >

    <button
      class="pm-burger"
      type="button"
      data-burger
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Abrir el menú"
    >
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const abierto = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!abierto));
      burger.setAttribute('aria-label', abierto ? 'Abrir el menú' : 'Cerrar el menú');
      menu.dataset.abierto = String(!abierto);
    });

    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        menu.dataset.abierto = 'false';
      })
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.abierto === 'true') {
        burger.setAttribute('aria-expanded', 'false');
        menu.dataset.abierto = 'false';
        burger.focus();
      }
    });
  }

  if (header) {
    const marcar = () => {
      header.dataset.scrolled = String(window.scrollY > 12);
    };
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });
  }
</script>
