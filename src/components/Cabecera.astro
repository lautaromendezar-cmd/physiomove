---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo.png';
import { centro, contacto, servicios } from '../data/contenido';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const actual = (href: string) =>
  href === '/' ? ruta === '/' : ruta.startsWith(href.replace(/\/$/, ''));

const enlaces = [
  { href: '/servicios', texto: 'Servicios' },
  { href: '/equipo', texto: 'Equipo' },
  { href: '/obras-sociales', texto: 'Obras sociales' },
  { href: '/contacto', texto: 'Contacto' },
];
---

<header class="pm-header" data-header>
  <div class="contenedor pm-header__inner">
    <a class="pm-logo" href="/" aria-label={`${centro.nombre}, inicio`}>
      <Image src={logo} alt="" width={88} height={88} loading="eager" />
      <span class="pm-logo__texto">
        {centro.nombre}
        <small>Centro deportivo especializado</small>
      </span>
    </a>

    <nav class="pm-nav" id="menu" data-menu aria-label="Principal">
      <ul class="pm-nav__lista">
        {
          enlaces.map((e) =>
            e.href === '/servicios' ? (
              <li class="pm-nav__item pm-nav__item--sub" data-sub>
                <a href={e.href} aria-current={actual(e.href) ? 'page' : undefined}>
                  {e.texto}
                </a>
                <button
                  class="pm-nav__abrir"
                  type="button"
                  data-sub-boton
                  aria-expanded="false"
                  aria-controls="submenu-servicios"
                  aria-label="Ver todos los servicios"
                >
                  <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
                    <path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>

                <ul class="pm-sub" id="submenu-servicios">
                  {servicios.map((s, i) => (
                    <li style={`--i:${i}`}>
                      <a
                        href={`/servicios/${s.slug}`}
                        aria-current={ruta === `/servicios/${s.slug}` ? 'page' : undefined}
                      >
                        <span>{s.numero}</span>
                        {s.nombre}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="pm-nav__item">
                <a href={e.href} aria-current={actual(e.href) ? 'page' : undefined}>
                  {e.texto}
                </a>
              </li>
            )
          )
        }
      </ul>

      <a class="btn" href={contacto.whatsappTexto} target="_blank" rel="noopener">
        Agendá tu turno
      </a>
    </nav>

    <a
      class="btn pm-header__cta"
      href={contacto.whatsappTexto}
      target="_blank"
      rel="noopener">Agendá tu turno</a
    >

    <button
      class="pm-burger"
      type="button"
      data-burger
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Abrir el menú"
    >
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const sub = document.querySelector<HTMLElement>('[data-sub]');
  const subBoton = document.querySelector<HTMLButtonElement>('[data-sub-boton]');

  const cerrarSub = () => {
    if (!sub || !subBoton) return;
    sub.dataset.abierto = 'false';
    subBoton.setAttribute('aria-expanded', 'false');
  };

  const cerrarMenu = () => {
    if (!burger || !menu) return;
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Abrir el menú');
    menu.dataset.abierto = 'false';
    cerrarSub();
  };

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const abierto = burger.getAttribute('aria-expanded') === 'true';
      if (abierto) return cerrarMenu();
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Cerrar el menú');
      menu.dataset.abierto = 'true';
    });

    // Los links navegan y cierran; el boton del submenu no debe cerrar nada.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', cerrarMenu));
  }

  if (sub && subBoton) {
    subBoton.addEventListener('click', () => {
      const abierto = sub.dataset.abierto === 'true';
      sub.dataset.abierto = String(!abierto);
      subBoton.setAttribute('aria-expanded', String(!abierto));
    });

    // En desktop el submenu se abre solo al pasar el mouse o al tabular dentro
    // (lo hace el CSS). Aca solo se corrige el estado del boton al salir.
    sub.addEventListener('mouseleave', cerrarSub);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (sub && sub.dataset.abierto === 'true') {
      cerrarSub();
      subBoton?.focus();
      return;
    }
    if (menu && menu.dataset.abierto === 'true') {
      cerrarMenu();
      burger?.focus();
    }
  });

  if (header) {
    const marcar = () => {
      header.dataset.scrolled = String(window.scrollY > 12);
    };
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });
  }
</script>
